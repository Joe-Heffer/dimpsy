# Normalise line endings for text files.
* text=auto eol=lf

# CAD, 3D and image files are binary: never diff or convert them.
*.stl binary
*.STL binary
*.step binary
*.stp binary
*.FCStd binary
*.3mf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
